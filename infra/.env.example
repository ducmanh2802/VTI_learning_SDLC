# Name of the Docker Compose project; prefixes containers, volumes and network.
COMPOSE_PROJECT_NAME=vnstockai

# Database name created on first start.
POSTGRES_DB=vnstockai

# Database user created on first start.
POSTGRES_USER=vnstockai

# Database password; change before use, never commit the real value.
POSTGRES_PASSWORD=change-me-postgres

# Host port for PostgreSQL; published on 127.0.0.1 only.
POSTGRES_PORT=5432

# Password for the Core service login role (core_svc); change before use.
CORE_DB_PASSWORD=change-me-core

# Password for the Analytics service login role (analytics_svc); change before use.
ANALYTICS_DB_PASSWORD=change-me-analytics

# Redis password; change before use, never commit the real value.
REDIS_PASSWORD=change-me-redis

# Host port for Redis; published on 127.0.0.1 only.
REDIS_PORT=6379
